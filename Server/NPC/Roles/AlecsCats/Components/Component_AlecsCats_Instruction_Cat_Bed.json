              "Compute": "CatBedCooldownRange"
            }
          },
          {
            "Type": "TimerRestart",
            "Name": "CatBed_Cooldown"
          },
          {
            "Type": "TimerStart",
            "Name": "CatEnrich_Rest",
            "StartValueRange": [
              12,
