          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Timer",
                "Name": "Ball_Rest",
                "State": "Stopped"
              },
              {
                "Type": "Leash",
                "Range": 6
              },
              {
                "Type": "Mob",
                "Range": 0.7,
                "GetPlayers": true,
                "GetNPCs": false,
                "LockOnTarget": true,
                "LockedTargetSlot": "Batter"
              }
            ]
          },
          "BodyMotion": {
            "Type": "Nothing"
          },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Ball_Home",
              "StartValueRange": [
                1.5,
                2.5
              ],
              "RestartValueRange": [
                1.5,
                2.5
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Home"
            },
            {
              "Type": "TimerStart",
              "Name": "Ball_Rest",
              "StartValueRange": [
                1.8,
                2.4
              ],
              "RestartValueRange": [
                1.8,
                2.4
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Rest"
            }
          ]
        },
        {
          "$Comment": "A player walked into it.",
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Timer",
                "Name": "Ball_Rest",
