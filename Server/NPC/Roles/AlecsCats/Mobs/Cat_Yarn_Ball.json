              "RestartValueRange": [
                0.8,
                1.3
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Roll"
            }
          ]
        },
        {
          "$Comment": "Roll back toward where the ball landed, so repeated swats in one direction cannot carry it away.",
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Not",
                "Sensor": {
                  "Type": "Timer",
                  "Name": "Ball_Home",
                  "State": "Stopped"
                }
              },
              {
                "Type": "Leash",
                "Range": 1.5
              }
            ]
          },
          "BodyMotion": {
            "Type": "Seek",
            "RelativeSpeed": 1,
            "SlowDownDistance": 2,
            "StopDistance": 1
