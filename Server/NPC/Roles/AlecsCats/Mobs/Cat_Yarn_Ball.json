          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Ball_Home",
              "StartValueRange": [
                1.5,
                2.5
              ],
              "RestartValueRange": [
                1.5,
                2.5
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Home"
            }
          ]
        },
        {
          "$Comment": "A pet cat swatted the ball: start rolling on this same tick.",
          "Continue": true,
          "Sensor": {
            "Type": "Beacon",
            "Message": "AlecsCats_Yarn_Swat",
            "Range": 3,
            "TargetSlot": "Batter"
