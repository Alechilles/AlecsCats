                "Range": 0.7,
                "GetPlayers": true,
                "GetNPCs": false,
                "LockOnTarget": true,
                "LockedTargetSlot": "Batter"
              }
            ]
          },
          "BodyMotion": {
            "Type": "Nothing"
          },
          "Actions": [
            {
              "Type": "TimerStart",
              "Name": "Ball_Roll",
              "StartValueRange": [
                0.8,
                1.3
              ],
              "RestartValueRange": [
                0.8,
                1.3
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Roll"
            },
            {
              "Type": "TimerStart",
              "Name": "Ball_Rest",
              "StartValueRange": [
                1.8,
                2.4
              ],
              "RestartValueRange": [
                1.8,
                2.4
              ]
            },
            {
              "Type": "TimerRestart",
              "Name": "Ball_Rest"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "BodyMotion": {
            "Type": "Nothing"
          }
        }
