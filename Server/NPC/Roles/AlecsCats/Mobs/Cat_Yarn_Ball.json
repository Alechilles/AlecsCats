        {
          "$Comment": "Roll away from whoever touched it while the roll timer runs.",
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Not",
                "Sensor": {
                  "Type": "Timer",
                  "Name": "Ball_Roll",
                  "State": "Stopped"
                }
              },
              {
                "Type": "Target",
                "TargetSlot": "Batter",
                "Range": 12
