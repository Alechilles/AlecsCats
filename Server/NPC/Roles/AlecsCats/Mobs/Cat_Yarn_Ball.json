        {
          "$Comment": "Stop a normal roll at the edge of the play area.",
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Not",
                "Sensor": {
                  "Type": "Timer",
                  "Name": "Ball_Roll",
