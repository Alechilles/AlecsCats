{
  "Id": "AlecsCats_Husbandry_Bench_Cats_Category",
  "$Comment": "Adds a Cats tab to the Animal Husbandry Workbench when Alec's Animal Husbandry is installed.",
  "Target": "Server/Item/Items/Bench/AH_Bench_Husbandry.json",
  "When": {
    "TargetExists": true
  },
  "Operations": [
    {
      "Id": "add-cats-category",
      "Op": "Insert",
      "Path": "/BlockType/Bench/Categories",
      "Existing": {
        "Id": "AlecsCats_Cats"
      },
      "Value": {
        "Id": "AlecsCats_Cats",
        "Icon": "Icons/CraftingCategories/AlecsCats/Cats.png",
        "Name": "server.benchCategories.alecsCats.cats"
      }
    }
  ]
}
